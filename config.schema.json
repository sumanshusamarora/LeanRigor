{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/leanrigor/config.schema.json",
  "title": "LeanRigor Configuration",
  "type": "object",
  "properties": {
    "version": {
      "const": 1
    },
    "workflow": {
      "type": "object",
      "properties": {
        "defaultMode": {
          "enum": [
            "adaptive",
            "fast",
            "standard",
            "rigorous"
          ],
          "default": "adaptive"
        },
        "allowUserOverride": {
          "type": "boolean",
          "default": true
        },
        "automaticTriage": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "models": {
      "type": "object",
      "properties": {
        "tiers": {
          "type": "object",
          "properties": {
            "small": {
              "type": "object",
              "additionalProperties": {
                "type": "string",
                "minLength": 1
              }
            },
            "medium": {
              "type": "object",
              "additionalProperties": {
                "type": "string",
                "minLength": 1
              }
            },
            "large": {
              "type": "object",
              "additionalProperties": {
                "type": "string",
                "minLength": 1
              }
            },
            "inherit": {
              "type": "object",
              "additionalProperties": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "additionalProperties": false
        },
        "failIfUnavailable": {
          "type": "boolean",
          "default": true
        },
        "fallback": {
          "type": "object",
          "properties": {
            "small": {
              "type": "array",
              "items": {
                "enum": [
                  "small",
                  "medium",
                  "large",
                  "inherit"
                ]
              }
            },
            "medium": {
              "type": "array",
              "items": {
                "enum": [
                  "small",
                  "medium",
                  "large",
                  "inherit"
                ]
              }
            },
            "large": {
              "type": "array",
              "items": {
                "enum": [
                  "small",
                  "medium",
                  "large",
                  "inherit"
                ]
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "routing": {
      "type": "object",
      "additionalProperties": {
        "enum": [
          "small",
          "medium",
          "large",
          "inherit"
        ]
      }
    },
    "instructions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "completionGate": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "requireEvidence": {
          "type": "boolean",
          "default": true
        },
        "requireValidation": {
          "type": "boolean",
          "default": true
        },
        "allowSkippedValidation": {
          "type": "object",
          "properties": {
            "fast": {
              "type": "boolean",
              "default": true
            },
            "standard": {
              "type": "boolean",
              "default": false
            },
            "rigorous": {
              "type": "boolean",
              "default": false
            }
          },
          "additionalProperties": false
        },
        "maxRepairAttempts": {
          "type": "object",
          "properties": {
            "fast": {
              "type": "integer",
              "minimum": 0,
              "default": 1
            },
            "standard": {
              "type": "integer",
              "minimum": 0,
              "default": 2
            },
            "rigorous": {
              "type": "integer",
              "minimum": 0,
              "default": 2
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "taskSizing": {
      "type": "object",
      "properties": {
        "maxPrimaryObjectives": {
          "type": "integer",
          "minimum": 1,
          "default": 1
        },
        "preferredWriteFiles": {
          "type": "integer",
          "minimum": 1,
          "default": 5
        },
        "reviewSplitThresholdFiles": {
          "type": "integer",
          "minimum": 1,
          "default": 8
        },
        "requireSplitWhen": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "multiple architectural boundaries",
            "independent backend and frontend outcomes",
            "database migration plus application behaviour",
            "public contract plus consumer updates",
            "implementation mixed with unrelated refactoring"
          ]
        }
      },
      "additionalProperties": false
    },
    "introspection": {
      "type": "object",
      "properties": {
        "preflight": {
          "enum": [
            "always",
            "mode-based",
            "manual"
          ],
          "default": "always"
        },
        "deepReflection": {
          "enum": [
            "triggered",
            "always",
            "manual"
          ],
          "default": "triggered"
        },
        "triggerAfterFailedRepairs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10,
          "default": 2
        },
        "triggerOnScopeExpansion": {
          "type": "boolean",
          "default": true
        },
        "triggerOnArchitectureChange": {
          "type": "boolean",
          "default": true
        }
      },
      "additionalProperties": false
    },
    "review": {
      "type": "object",
      "properties": {
        "fast": {
          "enum": [
            "sanity",
            "integrated",
            "deep"
          ],
          "default": "sanity"
        },
        "standard": {
          "enum": [
            "sanity",
            "integrated",
            "deep"
          ],
          "default": "integrated"
        },
        "rigorous": {
          "enum": [
            "integrated",
            "deep",
            "specialist"
          ],
          "default": "deep"
        },
        "multiAgent": {
          "enum": [
            "integrated",
            "deep",
            "specialist"
          ],
          "default": "integrated"
        },
        "highRiskPaths": {
          "enum": [
            "deep",
            "specialist"
          ],
          "default": "deep"
        },
        "allowUserOverride": {
          "type": "boolean",
          "default": true
        }
      },
      "additionalProperties": false
    },
    "triage": {
      "type": "object",
      "properties": {
        "chooseLowestSafeMode": {
          "type": "boolean",
          "default": true
        },
        "requireExplicitRigorousTrigger": {
          "type": "boolean",
          "default": true
        },
        "fastRequiresPositiveEvidence": {
          "type": "boolean",
          "default": true
        },
        "highConfidenceThreshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.8
        },
        "mediumConfidenceThreshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.55
        },
        "maxEscalationReasons": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5,
          "default": 3
        },
        "maxAssumptions": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5,
          "default": 3
        },
        "maxInspectionTargets": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10,
          "default": 5
        },
        "fallbackMode": {
          "enum": [
            "standard",
            "rigorous"
          ],
          "default": "standard"
        }
      },
      "additionalProperties": false
    },
    "parallelism": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "maxAgents": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        },
        "isolation": {
          "enum": [
            "shared-worktree",
            "isolated-worktrees"
          ]
        },
        "forbidSharedWrites": {
          "type": "boolean"
        }
      }
    },
    "execution": {
      "type": "object",
      "properties": {
        "maxParallelPhases": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16,
          "default": 1
        },
        "pollIntervalSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600,
          "default": 5
        },
        "workerTimeoutSeconds": {
          "type": "integer",
          "minimum": 5,
          "maximum": 86400,
          "default": 1800
        },
        "heartbeatGraceSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600,
          "default": 30
        },
        "workflowLockTimeoutSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600,
          "default": 30
        },
        "phaseLeaseTimeoutSeconds": {
          "type": "integer",
          "minimum": 5,
          "maximum": 86400,
          "default": 900
        },
        "writeReadConflictsBlock": {
          "type": "boolean",
          "default": true
        },
        "sensitivePaths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "default": []
        },
        "workspaceStrategy": {
          "enum": [
            "none",
            "git-worktree"
          ],
          "default": "git-worktree"
        },
        "workspaceRoot": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "default": null
        },
        "retainCompletedPhaseWorktrees": {
          "type": "boolean",
          "default": true
        },
        "retainIntegrationWorktree": {
          "type": "boolean",
          "default": true
        },
        "integrationTransferStrategy": {
          "enum": [
            "internal-commit"
          ],
          "default": "internal-commit"
        },
        "workspaceBranchPrefix": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._/-]+$",
          "default": "leanrigor"
        },
        "maxWorkspacePathLength": {
          "type": "integer",
          "minimum": 80,
          "maximum": 1024,
          "default": 220
        },
        "internalCommitSigning": {
          "enum": [
            "disabled",
            "git-config"
          ],
          "default": "disabled"
        },
        "dependencyBootstrap": {
          "enum": [
            "block",
            "auto-lockfile"
          ],
          "default": "block"
        },
        "workerControls": {
          "type": "object",
          "properties": {
            "environment": {
              "enum": [
                "bare",
                "safe-mode",
                "default"
              ],
              "default": "bare"
            },
            "maxDiscoveryTurns": {
              "type": "object",
              "properties": {
                "fast": { "type": "integer", "minimum": 0, "maximum": 20, "default": 1 },
                "standard": { "type": "integer", "minimum": 0, "maximum": 20, "default": 2 },
                "rigorous": { "type": "integer", "minimum": 0, "maximum": 20, "default": 4 }
              },
              "additionalProperties": false
            },
            "reservedValidationTurns": {
              "type": "object",
              "properties": {
                "fast": { "type": "integer", "minimum": 0, "maximum": 10, "default": 1 },
                "standard": { "type": "integer", "minimum": 0, "maximum": 10, "default": 1 },
                "rigorous": { "type": "integer", "minimum": 0, "maximum": 10, "default": 2 }
              },
              "additionalProperties": false
            },
            "reservedFinalResultTurns": {
              "type": "object",
              "properties": {
                "fast": { "type": "integer", "minimum": 1, "maximum": 10, "default": 1 },
                "standard": { "type": "integer", "minimum": 1, "maximum": 10, "default": 1 },
                "rigorous": { "type": "integer", "minimum": 1, "maximum": 10, "default": 1 }
              },
              "additionalProperties": false
            },
            "repeatedReadWarningThreshold": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20,
              "default": 2
            },
            "largeToolOutputBytes": {
              "type": "integer",
              "minimum": 1024,
              "maximum": 1048576,
              "default": 32768
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "git": {
      "type": "object",
      "properties": {
        "autoCommit": {
          "const": false
        },
        "requireConfirmation": {
          "type": "boolean"
        },
        "commitStyle": {
          "enum": [
            "conventional",
            "plain"
          ]
        }
      }
    },
    "budgets": {
      "type": "object",
      "properties": {
        "clarificationQuestions": {
          "type": "integer",
          "minimum": 0,
          "default": 3
        },
        "options": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5,
          "default": 3
        },
        "reviewRounds": {
          "type": "integer",
          "minimum": 0,
          "default": 1
        },
        "repairRounds": {
          "type": "integer",
          "minimum": 0,
          "default": 2
        },
        "triageCalls": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3,
          "default": 2
        },
        "triageRecommendationMaxTurns": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5,
          "default": 2
        },
        "triageRecommendationRepairAttempts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2,
          "default": 1
        },
        "triageInspectionMaxTurns": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10,
          "default": 5
        },
        "triageInspectionMaxReads": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20,
          "default": 4
        },
        "triageInspectionMaxBytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 262144,
          "default": 30000
        },
        "triageInspectionTimeoutSeconds": {
          "type": "integer",
          "minimum": 5,
          "maximum": 600,
          "default": 120
        },
        "phaseBriefInspectionMaxReads": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50,
          "default": 12
        },
        "phaseBriefInspectionMaxBytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 1048576,
          "default": 120000
        },
        "phaseBriefInspectionTimeoutSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 600,
          "default": 30
        },
        "phaseBriefRepairAttempts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2,
          "default": 1
        },
        "phaseBriefRefreshedInspectionAttempts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2,
          "default": 1
        },
        "phaseBriefAlternateStrategyAttempts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2,
          "default": 1
        },
        "phaseBriefDeterministicFallbackAttempts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2,
          "default": 1
        },
        "planningMaxTurns": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50,
          "default": 7
        },
        "planningRepairMaxTurns": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50,
          "default": 4
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
